# ==========================================
# RAZORPAY PAYMENT CONFIGURATION (SPOOL)
# ==========================================
# Get your API keys from: https://dashboard.razorpay.com/app/keys

# Public Key ID (Safe for frontend)
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# Secret Key (Private, Server Only)
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# Webhook Secret (Optional, for payment notification verification)
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Base URL
VITE_BASE_URL=http://localhost:8080
